# Copy this file to .env.local for local development.
# On Vercel, add the same variables under Project Settings -> Environment Variables.

# Supabase: Project Settings -> API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" key. Newer dashboards may label it "publishable key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# OpenAI: platform.openai.com -> API keys (server-side only)
OPENAI_API_KEY=your-openai-api-key

# Alternative: use an OpenRouter key instead of OPENAI_API_KEY.
# If set, it takes priority. Chat model names then need the provider
# prefix, for example openai/gpt-4o-mini.
# OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: model used to write answers. Defaults to gpt-4o-mini if not set.
# OPENAI_CHAT_MODEL=gpt-4o-mini
